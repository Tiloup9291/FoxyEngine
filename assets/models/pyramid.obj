mtllib pyramid.mtl
# Square-base pyramid (5 vertices, 1 quad + 4 triangles -> 6 triangles)
v -1 0 -1
v 1 0 -1
v 1 0 1
v -1 0 1
v 0 1.5 0
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vt 0.5 0.5
vn 0 -1 0
vn 0 0.447 0.894
vn 0.894 0.447 0
vn 0 0.447 -0.894
vn -0.894 0.447 0
usemtl orange
f 1/1/1 2/2/1 3/3/1 4/4/1
usemtl yellow
f 1/1/2 4/4/2 5/5/2
f 4/4/5 3/3/5 5/5/5
f 3/3/3 2/2/3 5/5/3
f 2/2/4 1/1/4 5/5/4
