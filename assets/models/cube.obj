mtllib cube.mtl
# Demonstration cube (8 vertices, 6 quad faces -> 12 triangles)
# Per-face UVs for the checker texture
v -1 -1 -1
v 1 -1 -1
v 1 1 -1
v -1 1 -1
v -1 -1 1
v 1 -1 1
v 1 1 1
v -1 1 1
vt 0 0
vt 1 0
vt 1 1
vt 0 1
usemtl blue
f 5/1 6/2 7/3 8/4
usemtl gray
f 2/1 1/2 4/3 3/4
f 6/1 2/2 3/3 7/4
f 1/1 5/2 8/3 4/4
f 8/1 7/2 3/3 4/4
f 1/1 2/2 6/3 5/4

